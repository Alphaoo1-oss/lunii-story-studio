{
  "name": "lunii-story-studio",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Application web locale pour créer des histoires interactives pour Lunii (packs STUdio).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "app": "concurrently -n serveur,web -c blue,magenta \"tsx src/server/index.ts\" \"vite\"",
    "dev": "concurrently -n serveur,web -c blue,magenta \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "tsx src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "seed:reference": "tsx scripts/seed-reference.ts",
    "claude:login": "tsx scripts/claude-cli.ts auth login",
    "claude:status": "tsx scripts/claude-cli.ts auth status --text"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.312",
    "@anthropic-ai/sdk": "^1.3.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/static": "^10.1.8",
    "@fontsource/baloo-2": "^5.3.0",
    "fastify": "^5.12.7",
    "ffmpeg-static": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "sharp": "^0.35.5",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
